import { useEffect, useRef } from 'react';

/**
 * Shows a web notification via the active ServiceWorkerRegistration's
 * showNotification() (the spec-preferred path). Falls back to the direct
 * Notification constructor only when no service worker is available/ready,
 * so notifications never silently fail. A 2s guard prevents waiting forever
 * when no service worker ever registers.
 */
async function showDeadlineNotification(title, body) {
  const options = { body, icon: '/favicon.ico' };
  if ('serviceWorker' in navigator && 'showNotification' in ServiceWorkerRegistration.prototype) {
    try {
      const reg = await Promise.race([
        navigator.serviceWorker.ready,
        new Promise((_, reject) => setTimeout(() => reject(new Error('sw-timeout')), 2000)),
      ]);
      await reg.showNotification(title, options);
      return;
    } catch {
      // No active service worker — fall through to the constructor fallback.
    }
  }
  if ('Notification' in window) {
    try { new Notification(title, options); } catch { /* permission denied or unsupported */ }
  }
}

/**
 * Fires browser notifications for tasks approaching their deadline.
 * Checks every 5 minutes and notifies once per task per session.
 */
export default function useDeadlineNotifications(tasks) {
  const notifiedIds = useRef(new Set());

  useEffect(() => {
    if (!tasks || tasks.length === 0) return;

    const requestPermission = async () => {
      if (Notification.permission === 'default') {
        await Notification.requestPermission();
      }
    };
    requestPermission();

    const checkDeadlines = () => {
      if (Notification.permission !== 'granted') return;

      const now = new Date();

      tasks.forEach(task => {
        if (!task.due_date || task.status === 'done') return;
        if (notifiedIds.current.has(task.id)) return;

        const due = new Date(task.due_date);
        const diffHours = (due - now) / (1000 * 60 * 60);

        let message = null;
        if (diffHours < 0) {
          message = `⚠️ Overdue: "${task.title}" was due ${Math.abs(Math.round(diffHours))}h ago.`;
        } else if (diffHours <= 2) {
          message = `🔴 Due in ${Math.round(diffHours * 60)}min: "${task.title}"`;
        } else if (diffHours <= 24) {
          const hrs = Math.round(diffHours);
          message = `🟡 Due in ~${hrs}h: "${task.title}"`;
        }

        if (message) {
          showDeadlineNotification('NeuroAligned — Task Deadline', message);
          notifiedIds.current.add(task.id);
        }
      });
    };

    // Run immediately, then every 5 minutes
    checkDeadlines();
    const interval = setInterval(checkDeadlines, 5 * 60 * 1000);
    return () => clearInterval(interval);
  }, [tasks]);
}