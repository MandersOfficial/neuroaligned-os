import { useEffect, useRef } from 'react';

/**
 * Fires browser notifications for tasks approaching their deadline.
 * Checks every 5 minutes and notifies once per task per session.
 */
export default function useDeadlineNotifications(tasks) {
  const notifiedIds = useRef(new Set());

  useEffect(() => {
    if (!tasks || tasks.length === 0) return;

    const requestPermission = async () => {
      if (Notification.permission === 'default') {
        await Notification.requestPermission();
      }
    };
    requestPermission();

    const checkDeadlines = () => {
      if (Notification.permission !== 'granted') return;

      const now = new Date();

      tasks.forEach(task => {
        if (!task.due_date || task.status === 'done') return;
        if (notifiedIds.current.has(task.id)) return;

        const due = new Date(task.due_date);
        const diffHours = (due - now) / (1000 * 60 * 60);

        let message = null;
        if (diffHours < 0) {
          message = `⚠️ Overdue: "${task.title}" was due ${Math.abs(Math.round(diffHours))}h ago.`;
        } else if (diffHours <= 2) {
          message = `🔴 Due in ${Math.round(diffHours * 60)}min: "${task.title}"`;
        } else if (diffHours <= 24) {
          const hrs = Math.round(diffHours);
          message = `🟡 Due in ~${hrs}h: "${task.title}"`;
        }

        if (message) {
          new Notification('NeuroAligned — Task Deadline', {
            body: message,
            icon: '/favicon.ico',
          });
          notifiedIds.current.add(task.id);
        }
      });
    };

    // Run immediately, then every 5 minutes
    checkDeadlines();
    const interval = setInterval(checkDeadlines, 5 * 60 * 1000);
    return () => clearInterval(interval);
  }, [tasks]);
}