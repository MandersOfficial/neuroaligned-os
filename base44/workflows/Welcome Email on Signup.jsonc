{
  "name": "Welcome Email on Signup",
  "description": "Sends a personalized welcome email when a user completes onboarding",
  "trigger": {
    "condition": "${ (.trigger.data.onboarding_completed == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "UserProfile"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "welcome_email_on_signup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWelcomeEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}