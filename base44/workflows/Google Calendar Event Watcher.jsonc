{
  "name": "Google Calendar Event Watcher",
  "description": "Watches Google Calendar for event changes and updates NeuroAligned project statuses accordingly.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "connector",
      "events": [
        "events"
      ],
      "integration_type": "googlecalendar",
      "resource_id": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_calendar_event_watcher",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onCalendarEventChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}