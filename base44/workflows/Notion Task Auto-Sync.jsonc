{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Notion Task Auto-Sync",
  "description": "Every 30 minutes, pulls new tasks from the pinned Notion database, matches them to projects, and updates project deadlines.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notion_task_auto_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_notion_tasks": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scheduledNotionTaskSync",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync Notion tasks",
            "description": "Pull, match, update deadlines"
          }
        }
      }
    ]
  }
}