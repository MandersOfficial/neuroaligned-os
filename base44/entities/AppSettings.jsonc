{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "title": "Setting Key"
    },
    "value": {
      "type": "string",
      "title": "Setting Value"
    },
    "label": {
      "type": "string",
      "title": "Display Label"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "general",
        "onboarding",
        "community",
        "ai",
        "email"
      ]
    },
    "type": {
      "type": "string",
      "title": "Input Type",
      "enum": [
        "text",
        "boolean",
        "number",
        "select"
      ]
    }
  },
  "required": [
    "key",
    "value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}