{
  "name": "BodyDoublingSession",
  "type": "object",
  "properties": {
    "host_email": {
      "type": "string",
      "title": "Host Email"
    },
    "host_name": {
      "type": "string",
      "title": "Host Name"
    },
    "partner_email": {
      "type": "string",
      "title": "Partner Email"
    },
    "partner_name": {
      "type": "string",
      "title": "Partner Name"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "waiting",
        "active",
        "completed"
      ],
      "default": "waiting"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "host_task": {
      "type": "string",
      "title": "Host's Focus Task"
    },
    "partner_task": {
      "type": "string",
      "title": "Partner's Focus Task"
    },
    "started_at": {
      "type": "string",
      "title": "Started At"
    },
    "completed_at": {
      "type": "string",
      "title": "Completed At"
    },
    "sprint_minutes": {
      "type": "number",
      "title": "Sprint Duration (minutes)",
      "default": 25
    }
  },
  "required": [
    "host_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "waiting"
        },
        {
          "data.status": "active"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.host_email": "{{user.email}}"
        },
        {
          "data.partner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.status": "waiting"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.host_email": "{{user.email}}"
        },
        {
          "data.partner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}