{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Task Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "notes": {
      "type": "array",
      "title": "Notes",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "todo",
        "in_progress",
        "done",
        "deferred"
      ],
      "default": "todo"
    },
    "energy_required": {
      "type": "string",
      "title": "Energy Required",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "deep_work",
        "admin",
        "creative",
        "communication",
        "self_care",
        "planning"
      ]
    },
    "project_id": {
      "type": "string",
      "title": "Project"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "estimated_minutes": {
      "type": "number",
      "title": "Estimated Minutes"
    },
    "is_today": {
      "type": "boolean",
      "title": "In Today's Queue",
      "default": false
    },
    "completed_at": {
      "type": "string",
      "title": "Completed At"
    },
    "eisenhower_quadrant": {
      "type": "string",
      "title": "Eisenhower Quadrant",
      "enum": [
        "do_first",
        "schedule",
        "delegate",
        "eliminate"
      ]
    },
    "recurrence": {
      "type": "string",
      "title": "Repeats",
      "enum": [
        "none",
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "none"
    },
    "reminder_frequency": {
      "type": "string",
      "title": "Reminder Frequency",
      "enum": [
        "none",
        "hourly",
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "none"
    },
    "last_reminded_at": {
      "type": "string",
      "title": "Last Reminder Sent At"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin",
            "email": "mandersofficial@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin",
            "email": "mandersofficial@gmail.com"
          }
        }
      ]
    }
  }
}