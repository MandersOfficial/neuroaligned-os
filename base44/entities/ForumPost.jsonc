{
  "name": "ForumPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "author_email": {
      "type": "string",
      "title": "Author Email"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "General",
        "ADHD Support",
        "Autism Support",
        "Business Strategy",
        "Burnout Recovery",
        "Tools & Tips",
        "Wins & Celebrations"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "approved",
        "removed",
        "flagged"
      ],
      "default": "pending"
    },
    "visibility": {
      "type": "string",
      "title": "Visibility",
      "enum": [
        "shared",
        "private"
      ],
      "default": "shared"
    },
    "flag_reason": {
      "type": "string",
      "title": "Flag Reason"
    },
    "likes": {
      "type": "number",
      "title": "Likes",
      "default": 0
    },
    "replies_count": {
      "type": "number",
      "title": "Replies Count",
      "default": 0
    }
  },
  "required": [
    "title",
    "content",
    "author_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.visibility": {
                "$in": [
                  "shared",
                  null
                ]
              }
            },
            {
              "data.status": "approved"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}