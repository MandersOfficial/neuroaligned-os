{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "submitter_email": {
      "type": "string",
      "title": "Submitter Email"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "general",
        "help",
        "review",
        "support",
        "bug"
      ],
      "default": "general"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "rating": {
      "type": "number",
      "title": "Rating"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "new"
    },
    "submitted_from": {
      "type": "string",
      "title": "Submitted From"
    }
  },
  "required": [
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.submitter_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}