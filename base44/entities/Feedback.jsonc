{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "submitter_email": {
      "type": "string",
      "title": "Submitter Email"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "general",
        "help",
        "review",
        "support",
        "bug"
      ],
      "default": "general"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "rating": {
      "type": "number",
      "title": "Rating"
    },
    "what_you_tried": {
      "type": "string",
      "title": "What You Were Trying To Do",
      "maxLength": 2000
    },
    "what_went_wrong": {
      "type": "string",
      "title": "What Went Wrong / Expected",
      "maxLength": 2000
    },
    "device_info": {
      "type": "string",
      "title": "Device / Browser"
    },
    "intent_usage": {
      "type": "string",
      "title": "How Often They'd Use It",
      "enum": [
        "Daily",
        "A few times a week",
        "Weekly",
        "Rarely",
        "No, not really"
      ]
    },
    "willingness_to_pay": {
      "type": "string",
      "title": "Willingness To Pay",
      "enum": [
        "free",
        "starter",
        "pro",
        "power"
      ]
    },
    "attachments": {
      "type": "array",
      "title": "Attachments",
      "items": {
        "type": "string"
      }
    },
    "review_consent": {
      "type": "boolean",
      "title": "Consent To Use Review",
      "default": false
    },
    "user_reply": {
      "type": "string",
      "title": "User Reply",
      "maxLength": 2000
    },
    "admin_notes": {
      "type": "string",
      "title": "Admin Notes",
      "maxLength": 4000
    },
    "admin_response": {
      "type": "string",
      "title": "Reply To User",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "new"
    },
    "submitted_from": {
      "type": "string",
      "title": "Submitted From"
    }
  },
  "required": [
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.submitter_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.submitter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}